# ═══════════════════════════════════════════════════════════════
# Имена переменных здесь СОВПАДАЮТ с тем, что читает код.
# Не переименовывай — код ищет именно эти ключи.
# ═══════════════════════════════════════════════════════════════

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/content_pipeline"

# Redis (либо REDIS_URL целиком, либо HOST+PORT)
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT=6379

# ── AI-сервисы ──────────────────────────────────────────────────
# Anthropic Claude — генерация текста статей + ресерч фактов
ANTHROPIC_API_KEY="sk-ant-..."
# OpenAI — ресерч фактов (GPT), поиск картинок (web_search), обложки (gpt-image)
OPENAI_API_KEY="sk-..."
# Perplexity — ресерч фактов + поиск редких архивных фото
PERPLEXITY_API_KEY="pplx-..."
# Google Gemini — ЕДИНСТВЕННЫЙ ключ для всего Gemini:
# валидация кандидатов картинок, генерация обложек (Nano Banana),
# построение поисковых запросов, Gemini-ресерч фактов.
# Берётся в https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza..."

# ── Поиск картинок ──────────────────────────────────────────────
# Google Custom Search (JSON API) — ключ из Google Cloud Console
# (проект с включённым Custom Search API). Это ДРУГОЙ ключ, не Gemini!
GOOGLE_API_KEY="AIza..."
# ID поискового движка (cx) из https://programmablesearchengine.google.com
GOOGLE_CX="..."
# Brave Search — альтернативный индекс картинок
BRAVE_SEARCH_API_KEY="..."
# imgbb — хостинг картинок для публикаций (опционально)
IMGBB_API_KEY="..."

# ── Публикация ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="..."
TELEGRAM_CHANNEL_ID="..."
TELEGRAPH_TOKEN="..."
VK_ACCESS_TOKEN="..."
VK_GROUP_ID="..."
DZEN_FP_TOKEN="..."

# ── Сервер ──────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# Хранилище файлов (на Railway задаётся автоматически через RAILWAY_VOLUME_MOUNT_PATH)
STORAGE_PATH=""
API_BASE_URL=""
