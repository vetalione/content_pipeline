re { pointer-events: none; border-radius: 16px; display: block; content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0; border: 0.5px solid var(--zenColorStrokePrimary, rgba(6, 6, 15, 0.35)); z-index: 2; opacity: 1; transition: all 0.2s ease 0.1s; } .unit-wrapper { overflow: unset; } .wrapper { position: relative; } .layout { position: relative; width: 100%; box-sizing: border-box; -webkit-font-smoothing: antialiased; border-radius: inherit; } .layout_image { border-bottom: 0.5px solid var(--zenColorStrokePrimary, rgba(6, 6, 15, 0.35)); } .layout_content { padding: 16px; } .title { color: var(--zenColorTextPrimary, rgba(6, 6, 15, 0.87)); font-size: 19px; font-weight: 700; line-height: 24px; letter-spacing: -0.24px; text-align: left; } .snippet { margin-top: 4px; color: var(--zenColorTextPrimary, rgba(6, 6, 15, 0.87)); font-size: 16px; font-weight: 400; line-height: 20px; letter-spacing: -0.12px; text-align: left; } .sitelinks { margin-top: 10px; max-height: 20px; overflow: hidden; } .ya-unit-sitelink { display: inline-block; margin-top: 2px; white-space: normal; color: var(--zenColorTextLink, rgb(0, 107, 231)); font-size: 16px; font-weight: 400; line-height: 20px; letter-spacing: -0.12px; text-align: left; } .ya-unit-sitelink:hover { color: var(--zenColorTextLinkHover, rgba(0, 107, 231, 0.7)); } .ya-unit-sitelink:not(:last-child) { margin-right: 12px; } .domain { margin-top: 12px; font-size: 13px; font-weight: 400; line-height: 16px; letter-spacing: -0.04px; text-align: left; color: var(--zenColorTextSecondary, rgba(6, 6, 15, 0.6)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .price { margin-top: 12px; } .price .ya-unit-price { display: flex; align-items: baseline; } .price .ya-unit-price-current { order: 0; font-size: 19px; font-weight: 700; line-height: 24px; letter-spacing: -0.24px; text-align: left; color: var(--zenColorTextPrimary, rgba(6, 6, 15, 0.87)); } .price .ya-unit-price-old { order: 1; margin-left: 8px; font-size: 13