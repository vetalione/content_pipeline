0px; } .sitelinks_with_price { overflow: hidden; max-height: 20px; } .ya-unit-sitelink { display: inline-block; margin-top: 2px; white-space: normal; color: var(--zenColorTextLink, rgb(0, 107, 231)); font-size: 16px; font-weight: 400; line-height: 20px; letter-spacing: -0.12px; text-align: left; } .ya-unit-sitelink:hover { color: var(--zenColorTextLinkHover, rgba(0, 107, 231, 0.7)); } .ya-unit-sitelink:not(:last-child) { margin-right: 12px; } .domain { margin-top: 12px; font-size: 13px; font-weight: 400; line-height: 16px; letter-spacing: -0.04px; text-align: left; color: var(--zenColorTextSecondary, rgba(6, 6, 15, 0.6)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .price { margin-top: 12px; } .price .ya-unit-price { display: flex; align-items: baseline; } .price .ya-unit-price-current { order: 0; font-size: 19px; font-weight: 700; line-height: 24px; letter-spacing: -0.24px; text-align: left; color: var(--zenColorTextPrimary, rgba(6, 6, 15, 0.87)); } .price .ya-unit-price-old { order: 1; margin-left: 8px; font-size: 13px; font-weight: 590; font-synthesis: none; line-height: 16px; letter-spacing: -0.04px; text-align: left; padding-top: 2px; color: var(--zenColorTextSecondary, rgba(6, 6, 15, 0.6)); text-decoration: line-through; } .price .ya-unit-discount { order: 2; margin-left: 8px; color: var(--zenColorTextWarning, rgb(211, 41, 71)); background-color: var(--zenColorPastelCoralShallow, rgb(252, 238, 238)); border-radius: 6px; display: inline-flex; justify-content: center; align-items: center; padding: 4px 6px; font-size: 13px; font-weight: 590; font-synthesis: none; line-height: 16px; letter-spacing: -0.04px; text-align: center; } .price .ya-unit-price-old::after { transform: unset; background: unset; } .button { position: relative; display: flex; align-items: center; justify-content: center; margin-top: 20px; height: 48px; border-radius: 12px; color: var(--zenColorTextLink, rgb(0, 107, 231)); background: var(--zenColorPastelGlacierShallow, rgb(233, 242, 251)); font-size: 15px; font-weight: 590; font-synthesis: none; line-height: 20px; letter-spacing: -0.12px; text-align: center; } .button:before { transition: all 0.15s ease-in; content: ''; opacity: 0; position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: var(--zenColorStateHover, rgba(0, 11, 33, 0.06)); border-radius: 12px; } .button:hover:before { opacity: 1; } .category { position: absolute; top: 12px; left: 12px; font-size: 10px; font-weight: 590; font-synthesis: none; line-height: 12px; letter-spacing: 0.12px; text-align: left; background: var(--zenColorBgMediaSecondary, rgba(0, 0, 0, 0.24)); color: var(--zenColorTextStaticWhitePrimary, rgb(255, 255, 255)); border-radius: 36px; padding: 6px 8px; z-index: 1; } .ya-image-gallery-warning, .yrw-ya-unit-image-footer { padding: 2px 4px; background: var(--zenColorBgMediaSecondary, rgba(0, 0, 0, 0.24)); color: var(--zenColorTextStaticWhiteSecondary, rgba(255, 255, 255, 0.7)); fill: var(--zenColorTextStaticWhiteSecondary, rgba(255, 255, 255, 0.7)); } .category:has(span.yrw-unit-category__age) { padding: 6px 5px 6px 8px; } .ya-unit-kebab_button { top: 12px; right: 12px; } .ya-unit-kebab_bg { background: var(--zenColorBgMediaSecondary, rgba(0, 0, 0, 0.24)); } .ya-unit-kebab_bg:before { transition: all 0.15s ease-in; content: ''; opacity: 0; position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: var(--zenColorStateHover, rgba(0, 11, 33, 0.06)); border-radius: 50%; } .ya-unit-kebab_button:hover .ya-unit-kebab_bg:before { opacity: 1; } .ya-image-gallery.ya-image-gallery button.ya-image-gallery-button { cursor: pointer; fill: var(--zenColorTextStaticWhitePrimary, rgb(255, 255, 255)); background: var(--zenColorBgMediaSecondary, rgba(0, 0, 0, 0.24)); width: 32px; height: 32px; } .ya-image-gallery.ya-image-gallery button.ya-image-gallery-button:before { transition: all 0.15s ease-in; content: ''; opacity: 0; position: absolute; top: 0; bottom: 0; left: 0; right: 0; backgroun